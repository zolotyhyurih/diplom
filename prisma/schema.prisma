generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum OcrStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum AuditAction {
  UPLOAD
  VIEW
  DOWNLOAD
  UPDATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  contracts Contract[]
  versions  ContractVersion[]
  auditLogs AuditLog[]

  @@map("users")
}

model Counterparty {
  id      String  @id @default(cuid())
  name    String  @unique
  inn     String? @unique
  contact String?

  contracts Contract[]

  @@map("counterparties")
}

model Category {
  id   String @id @default(cuid())
  name String @unique

  contracts Contract[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  contracts Contract[]

  @@map("tags")
}

model Contract {
  id             String         @id @default(cuid())
  number         String
  title          String
  description    String?
  status         ContractStatus @default(ACTIVE)
  signedAt       DateTime?      @map("signed_at") @db.Date
  startsAt       DateTime?      @map("starts_at") @db.Date
  expiresAt      DateTime?      @map("expires_at") @db.Date
  amount         Decimal?       @db.Decimal(14, 2)
  counterpartyId String         @map("counterparty_id")
  categoryId     String?        @map("category_id")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  counterparty Counterparty      @relation(fields: [counterpartyId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  versions     ContractVersion[]
  tags         Tag[]
  auditLogs    AuditLog[]

  @@index([expiresAt])
  @@index([counterpartyId])
  @@index([categoryId])
  @@map("contracts")
}

model ContractVersion {
  id            String    @id @default(cuid())
  contractId    String    @map("contract_id")
  versionNumber Int       @map("version_number")
  fileName      String    @map("file_name")
  mimeType      String    @map("mime_type")
  fileSize      Int       @map("file_size")
  storagePath   String    @map("storage_path")
  sha256        String
  ocrStatus     OcrStatus @default(PENDING) @map("ocr_status")
  ocrMethod     String?   @map("ocr_method")
  ocrError      String?   @map("ocr_error")
  pageCount     Int?      @map("page_count")
  extractedText String?   @map("extracted_text")
  // Вычисляется СУБД (см. миграцию search_vector), приложение это поле не записывает.
  searchVector  Unsupported("tsvector")? @map("search_vector")
  processedAt   DateTime? @map("processed_at")
  uploadedById  String    @map("uploaded_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([contractId, versionNumber])
  @@index([sha256])
  @@index([searchVector], map: "contract_versions_search_idx", type: Gin)
  @@map("contract_versions")
}

model AuditLog {
  id         String      @id @default(cuid())
  contractId String      @map("contract_id")
  userId     String      @map("user_id")
  action     AuditAction
  detail     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([contractId, createdAt])
  @@map("audit_logs")
}
